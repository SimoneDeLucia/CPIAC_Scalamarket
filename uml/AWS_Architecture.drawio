<mxfile host="app.diagrams.net" agent="Mozilla/5.0" version="21.3.0">
  <diagram name="AWS Architecture" id="aws-scalamarket">
    <mxGraphModel dx="1050" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- AWS Cloud Region -->
        <mxCell id="aws_region" value="AWS Region (eu-south-1)&#10;Budget: $100+/mo (Multi-Nodo)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;verticalAlign=top;fillColor=none;strokeColor=#FF9900;strokeWidth=2;fontStyle=1;spacingLeft=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="200" y="80" width="560" height="420" as="geometry" />
        </mxCell>

        <!-- VPC -->
        <mxCell id="vpc" value="VPC (10.0.0.0/16)" style="rounded=1;whiteSpace=wrap;html=1;dashed=0;align=left;verticalAlign=top;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;spacingLeft=10;spacingTop=10;fontColor=#333333;" vertex="1" parent="aws_region">
          <mxGeometry x="20" y="50" width="520" height="350" as="geometry" />
        </mxCell>

        <!-- Internet Gateway -->
        <mxCell id="igw" value="Internet Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="vpc">
          <mxGeometry x="200" y="-20" width="120" height="40" as="geometry" />
        </mxCell>

        <!-- Public Subnet 1 (AZ a) -->
        <mxCell id="subnet_a" value="Public Subnet 1 (AZ a)&#10;10.0.1.0/24" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=10;spacingTop=10;" vertex="1" parent="vpc">
          <mxGeometry x="30" y="150" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- Public Subnet 2 (AZ b) -->
        <mxCell id="subnet_b" value="Public Subnet 2 (AZ b)&#10;10.0.2.0/24" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;align=left;verticalAlign=top;fillColor=#e1d5e7;strokeColor=#9673a6;spacingLeft=10;spacingTop=10;" vertex="1" parent="vpc">
          <mxGeometry x="270" y="150" width="220" height="180" as="geometry" />
        </mxCell>

        <!-- Application Load Balancer -->
        <mxCell id="alb" value="Application Load Balancer&#10;(ALB)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;spacing=5;" vertex="1" parent="vpc">
          <mxGeometry x="110" y="60" width="300" height="50" as="geometry" />
        </mxCell>

        <!-- K8s Node Clients (EC2) -->
        <mxCell id="ec2_node_clients" value="EC2 Instance (t3.medium)&#10;Applicazioni Clienti" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="subnet_a">
          <mxGeometry x="20" y="50" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- K8s Node Admin (EC2) -->
        <mxCell id="ec2_node_admin" value="EC2 Instance (t3.medium)&#10;Applicazioni Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="subnet_b">
          <mxGeometry x="20" y="50" width="180" height="110" as="geometry" />
        </mxCell>

        <!-- Users -->
        <mxCell id="users" value="Users (Internet)" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="150" width="120" height="80" as="geometry" />
        </mxCell>

        <!-- Connections -->
        <!-- Users to IGW -->
        <mxCell id="edge_users_igw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;" edge="1" parent="1" source="users" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- IGW to ALB -->
        <mxCell id="edge_igw_alb" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;" edge="1" parent="vpc" source="igw" target="alb">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ALB to EC2 Clients -->
        <mxCell id="edge_alb_ec2_clients" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;" edge="1" parent="vpc" source="alb" target="ec2_node_clients">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- ALB to EC2 Admin -->
        <mxCell id="edge_alb_ec2_admin" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endFill=1;strokeWidth=2;" edge="1" parent="vpc" source="alb" target="ec2_node_admin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
